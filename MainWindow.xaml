<Window x:Class="VideoShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VideoShelf.Controls"
        Title="Megumiaomiao" Icon="pack://application:,,,/Assets/Huihui.png" Width="1240" Height="820" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#101217" Foreground="#F4F6FA"
        WindowStyle="None" ResizeMode="CanResize" PreviewKeyDown="Window_KeyDown" PreviewMouseLeftButtonDown="WindowChrome_MouseLeftButtonDown" Activated="Window_Activated"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#2B303B"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.62"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource RoundedButton}"/>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="3"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#667080" CornerRadius="5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
                </Track></Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ContextMenu"><Setter Property="Background" Value="#242936"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4A556B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="MenuItem"><Setter Property="Background" Value="#242936"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="2"/></Style>
        <Style x:Key="PreviewToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="Background" Value="#3B4354"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="#4A556B"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="#5865F2"/><Setter Property="Foreground" Value="White"/></Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions><Condition Property="IsChecked" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
                        <Setter TargetName="ToggleBorder" Property="Background" Value="#6B76FF"/>
                    </MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="Background" Value="#2F3645"/>
            <Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="Background" Value="#343C4C"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Background="#343C4C" CornerRadius="9" Padding="12,0">
                                <Grid><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center"/>
                                    <Path Data="M 0,0 L 5,5 L 10,0" Stroke="#C9CFDA" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border MinWidth="{TemplateBinding ActualWidth}" Margin="0,5,0,0" Background="#2F3645" CornerRadius="9" BorderBrush="#4A556B" BorderThickness="1" Padding="3">
                            <ScrollViewer><ItemsPresenter/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlaybackSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" VerticalAlignment="Center">
                            <Track x:Name="PART_Track" VerticalAlignment="Center" Height="16">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#6573FF" Height="5" CornerRadius="3" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#FFFFFF" Stroke="#6573FF" StrokeThickness="2.5"/></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#667080" Height="5" CornerRadius="3" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid x:Name="TopToolbar" Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock x:Name="BrandText" Text="Megumiaomiao" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AuthorText" Text="作者 Aly0（使用 ChatGPT 生成）" FontSize="10" Foreground="#9299A8"/>
                </StackPanel>
                <Button x:Name="SelectFolderButton" Content="选择视频目录" Click="SelectFolderButton_Click"/>
                <ToggleButton x:Name="OverviewCheck" Style="{StaticResource PreviewToggleStyle}" Content="总览" IsChecked="True" Click="Overview_Click"/>
                <ToggleButton x:Name="FolderViewCheck" Style="{StaticResource PreviewToggleStyle}" Content="文件夹浏览" Click="FolderView_Click"/>
                <TextBox x:Name="SearchBox" Width="130" Height="36" Margin="0,0,8,0" Padding="10,7" Background="#343C4C" Foreground="White" BorderThickness="0" ToolTip="搜索文件名" TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="SortBox" Width="130" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged">
                    <ComboBoxItem Content="默认排序"/><ComboBoxItem Content="文件大小 ↑"/><ComboBoxItem Content="文件大小 ↓"/>
                    <ComboBoxItem Content="新增时间 ↑"/><ComboBoxItem Content="新增时间 ↓"/><ComboBoxItem Content="视频时长 ↑"/><ComboBoxItem Content="视频时长 ↓"/>
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="FolderText" Grid.Column="1" Foreground="#9299A8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <CheckBox x:Name="FunscriptOnlyCheck" Content="有 funscript" ToolTip="勾选后只显示拥有同名 funscript 的视频" Foreground="#F2F4F8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,12,0" Checked="FunscriptFilterChanged" Unchecked="FunscriptFilterChanged"/>
                <ToggleButton x:Name="FavoritesCheck" Style="{StaticResource PreviewToggleStyle}" Content="♥ 收藏夹" ToolTip="只显示已收藏的视频；红心表示收藏" VerticalAlignment="Center" Checked="FavoritesFilterChanged" Unchecked="FavoritesFilterChanged"/>
                <Button x:Name="CollectionsButton" Content="合集" Background="#3B4354" Click="CollectionsButton_Click"/>
                <Button x:Name="BulkFavoriteButton" Content="♥ 收藏所选" Visibility="Collapsed" Background="#543642" Click="BulkFavorite_Click"/>
                <Button x:Name="BulkPlaylistButton" Content="＋ 加入列表" Visibility="Collapsed" Background="#4652C8" Click="BulkPlaylist_Click"/>
                <Button x:Name="BulkCollectionButton" Content="加入合集" Visibility="Collapsed" Background="#3E704D" Click="BulkCollection_Click"/>
                <Button x:Name="BulkDeleteButton" Content="删除所选" Visibility="Collapsed" Background="#6A3038" Click="BulkDelete_Click"/>
                <Button x:Name="ClearSelectionButton" Content="取消选择" Visibility="Collapsed" Background="#3B4354" Click="ClearSelection_Click"/>
                <Button x:Name="SettingsButton" Content="设置" Background="#3B4354" Click="SettingsButton_Click"/>
                <Button Content="—" Width="38" Padding="0" Background="Transparent" Click="MinimizeWindow_Click"/>
                <Button Content="▢" Width="38" Padding="0" Background="Transparent" Click="MaximizeWindow_Click"/>
                <Button Content="×" Width="38" Padding="0" Margin="0" Background="#452A32" Click="CloseWindow_Click"/>
            </StackPanel>
        </Grid>

        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Width="280" Padding="14" Margin="0,8,0,0" Background="#242936" CornerRadius="12" BorderBrush="#4A556B" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="播放与程序设置" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,12"/>
                    <ToggleButton x:Name="EmbeddedCheck" Style="{StaticResource PreviewToggleStyle}" Content="内嵌播放" IsChecked="True" Checked="PlaybackModeChanged" Unchecked="PlaybackModeChanged"/>
                    <ToggleButton x:Name="PreviewCheck" Style="{StaticResource PreviewToggleStyle}" Content="动态预览" Checked="PreviewModeChanged" Unchecked="PreviewModeChanged"/>
                    <TextBlock Text="排除小于指定大小的文件（MB）" Foreground="#B8BECA" Margin="2,8,0,3"/>
                    <TextBox x:Name="MinimumSizeBox" Height="30" Padding="8,4" Background="#171A21" Foreground="White" BorderBrush="#4A556B"/>
                    <TextBlock Text="排除短于指定时长的文件（秒）" Foreground="#B8BECA" Margin="2,8,0,3"/>
                    <TextBox x:Name="MinimumDurationBox" Height="30" Padding="8,4" Background="#171A21" Foreground="White" BorderBrush="#4A556B"/>
                    <Button Content="保存排除条件" Background="#5865F2" Click="SaveExclusionSettings_Click"/>
                    <Button x:Name="CacheFolderButton" Content="缓存目录" Background="#3B4354" Click="SelectCacheFolder_Click"/>
                    <Button x:Name="SelectMpvButton" Content="选择 mpv" Background="#3B4354" Click="SelectMpv_Click"/>
                    <ToggleButton x:Name="LanguageCheck" Style="{StaticResource PreviewToggleStyle}" Content="EN" Checked="LanguageChanged" Unchecked="LanguageChanged"/>
                </StackPanel>
            </Border>
        </Popup>

        <Border x:Name="RightPlaylistPanel" Grid.Row="1" Grid.RowSpan="1" Width="340" HorizontalAlignment="Right" Visibility="Collapsed" Panel.ZIndex="20" Background="#171A21" BorderBrush="#465063" BorderThickness="1" CornerRadius="12" Padding="10">
            <Grid>
            <DockPanel Margin="24,0,0,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,2,10">
                    <TextBlock x:Name="PlaylistTitleText" Text="播放列表" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <ToggleButton x:Name="ShuffleCheck" Style="{StaticResource PreviewToggleStyle}" Content="随机"/>
                    <Button x:Name="ClearPlaylistButton" Content="清空" Padding="8,5" Background="#3B4354" Click="ClearPlaylist_Click"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PlaylistItems"/></ScrollViewer>
            </DockPanel>
            <Button x:Name="PlaylistCollapseButton" HorizontalAlignment="Left" VerticalAlignment="Center" Width="34" Height="90" Margin="-10,0,0,0" Content="›" Padding="0" ToolTip="收起播放列表" Panel.ZIndex="2" Click="CollapsePlaylist_Click"/>
            </Grid>
        </Border>
        <Button x:Name="PlaylistRestoreButton" Grid.Row="1" Grid.RowSpan="1" HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="90" Margin="0" Content="‹" Visibility="Collapsed" Panel.ZIndex="21" Click="RestorePlaylist_Click"/>

        <Popup x:Name="CollectionsPopup" PlacementTarget="{Binding ElementName=CollectionsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Width="420" MaxHeight="480" Margin="0,8,0,0" Padding="12" Background="#242936" CornerRadius="12" BorderBrush="#4A556B" BorderThickness="1">
                <DockPanel><Button DockPanel.Dock="Top" Content="＋ 新建合集" Background="#3E704D" Margin="0,0,0,10" Click="CreateCollection_Click"/><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="CollectionsItems"/></ScrollViewer></DockPanel>
            </Border>
        </Popup>

        <Border x:Name="PlayerPanel" Grid.Row="1" Height="436" Visibility="Collapsed" Background="#050608" CornerRadius="12" Margin="0,0,0,16" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition x:Name="PlayerHeaderRow" Height="42"/><RowDefinition Height="*"/><RowDefinition x:Name="PlayerControlsRow" Height="108"/></Grid.RowDefinitions>

                <Border x:Name="PlayerHeader" Grid.Row="0" Background="#171A21" Padding="12,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="关闭播放器" Padding="10,5" Background="#343A48" Click="ClosePlayer_Click"/>
                        <TextBlock x:Name="NowPlayingText" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Background="Black">
                    <controls:MpvPlayerHost x:Name="PlayerHost"/>
                    <Image x:Name="AudioCoverImage" Visibility="Collapsed" Stretch="Uniform" Panel.ZIndex="5"/>
                    <Border x:Name="LyricsPanel" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#B0101217" Padding="18,10" Panel.ZIndex="6">
                        <TextBlock x:Name="LyricsText" FontSize="24" Foreground="White" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </Grid>

                <Border x:Name="PlayerControls" Grid.Row="2" Background="#171A21" Padding="14,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="PlayPauseButton" ToolTip="播放/暂停（空格）" Width="48" Height="44" Padding="0" Background="#5865F2" Click="PlayPause_Click">
                            <Grid Width="20" Height="20">
                                <Path x:Name="PlayIcon" Data="M 4,2 L 18,10 L 4,18 Z" Fill="White" Stretch="Uniform" Margin="2"/>
                                <Grid x:Name="PauseIcon" Visibility="Collapsed" Width="18" Height="18">
                                    <Rectangle Width="5" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" HorizontalAlignment="Left"/>
                                    <Rectangle Width="5" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" ToolTip="停止" Width="44" Height="44" Padding="0" Background="#2B303B" Click="Stop_Click">
                            <Rectangle Width="15" Height="15" RadiusX="2" RadiusY="2" Fill="White"/>
                        </Button>
                        <Grid Grid.Column="3" Margin="8,0,12,0"><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="10,-2,0,0">
                                <Button x:Name="LoopAButton" Content="A" Width="30" Height="22" Padding="0" Margin="0,0,4,0" Background="#3B4354" ToolTip="设置循环起点；循环启用后再次点击可清除" Click="LoopA_Click"/>
                                <Button x:Name="LoopBButton" Content="B" Width="30" Height="22" Padding="0" Background="#3B4354" ToolTip="设置循环终点" Click="LoopB_Click"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Height="24" VerticalAlignment="Center">
                                <Slider x:Name="PlaybackSlider" Style="{StaticResource PlaybackSliderStyle}" Margin="10,0" Minimum="0" Maximum="1" Value="0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                <Border x:Name="PlaybackSeekSurface" Margin="10,0" Background="#01FFFFFF" Cursor="Hand" MouseLeftButtonDown="PlaybackSlider_MouseLeftButtonDown" MouseMove="PlaybackSlider_MouseMove" MouseLeftButtonUp="PlaybackSlider_MouseLeftButtonUp"/>
                            </Grid>
                            <controls:FunscriptTimeline x:Name="ScriptTimeline" Grid.Row="2" Margin="2,1"/>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0">
                                <TextBlock x:Name="CurrentTimeText" Text="00:00" Foreground="#F4F6FA"/>
                                <TextBlock Text=" / " Foreground="#7E8797"/>
                                <TextBlock x:Name="DurationText" Text="00:00" Foreground="#AAB1BE"/>
                            </StackPanel>
                        </Grid>
                        <ToggleButton x:Name="RandomPlayCheck" Grid.Column="4" Style="{StaticResource PreviewToggleStyle}" Content="随机播放" ToolTip="蓝色表示随机播放已开启"/>
                        <Button x:Name="FullscreenPlaylistButton" Grid.Column="4" Visibility="Collapsed" Content="播放列表" Background="#3B4354" Click="FullscreenPlaylist_Click"/>
                        <TextBlock Grid.Column="5" Text="音量" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB1BE"/>
                        <Slider x:Name="VolumeSlider" Style="{StaticResource PlaybackSliderStyle}" Margin="10,0" Grid.Column="6" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                        <Button Grid.Column="7" Content="全屏" ToolTip="切换全屏" Padding="12,5" Margin="10,0,0,0" Background="#2B303B" Click="Fullscreen_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="ProgressPanel" Grid.Row="2" Visibility="Collapsed" Background="#1A1D24" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ProgressBar x:Name="ScanProgress" Height="8" Minimum="0" Maximum="1" Foreground="#5865F2" Background="#303541"/>
                <TextBlock x:Name="ProgressText" Grid.Column="1" Margin="12,0,0,0" Foreground="#B8BECA" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid x:Name="LibraryPanel" Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="ExplorerToolbar" Grid.Row="0" Visibility="Collapsed" Background="#171A21" CornerRadius="10" Padding="8" Margin="0,0,0,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="FolderBackButton" Content="←" Width="38" Padding="0" ToolTip="后退" Click="FolderBack_Click"/>
                        <Button x:Name="FolderUpButton" Content="↑" Width="38" Padding="0" ToolTip="上一级" Click="FolderUp_Click"/>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="8,0,0,0">
                        <StackPanel x:Name="FolderBreadcrumb" Orientation="Horizontal"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="FolderTreeColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="FolderTreePanel" Visibility="Collapsed" Grid.Column="0" Background="#171A21" CornerRadius="10" Padding="6" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock x:Name="FolderTreeTitle" DockPanel.Dock="Top" Text="文件夹" FontSize="15" FontWeight="SemiBold" Margin="8,6,8,10"/>
                        <TreeView x:Name="FolderTree" Background="Transparent" Foreground="White" BorderThickness="0" SelectedItemChanged="FolderTree_SelectedItemChanged"/>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="VideoList">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <Border VerticalAlignment="Bottom" Background="#D91A1D24" CornerRadius="8" Padding="12,8" HorizontalAlignment="Left" Margin="4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Foreground="#B8BECA"/>
                    <TextBlock x:Name="FunscriptMissingText" Foreground="#E1A7A7" Margin="14,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border x:Name="ToastPanel" Grid.RowSpan="4" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" Padding="14,10" Background="#E9343A48" CornerRadius="10" Panel.ZIndex="100">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="14"/>
        </Border>
    </Grid>
</Window>
