<UserControl x:Class="VideoShelf.Controls.VideoCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="220"
        Height="180"
        MouseLeftButtonDown="UserControl_MouseLeftButtonDown"
        MouseLeftButtonUp="UserControl_MouseLeftButtonUp"
        MouseMove="UserControl_MouseMove"
        MouseEnter="UserControl_MouseEnter"
        MouseLeave="UserControl_MouseLeave">


    <Border Margin="10"
            Background="#303030"
            CornerRadius="8">


        <Grid>


            <Grid.RowDefinitions>

                <RowDefinition Height="120"/>

                <RowDefinition Height="60"/>

            </Grid.RowDefinitions>



            <Grid>


                <Image x:Name="Thumbnail"
           Stretch="UniformToFill"/>


                <Grid x:Name="PreviewHost" Visibility="Collapsed"/>

                <CheckBox x:Name="SelectionCheck" HorizontalAlignment="Left" VerticalAlignment="Top"
                          Width="24" Height="24" Margin="8" ToolTip="选择此视频" Panel.ZIndex="10"
                          Checked="SelectionCheck_Changed" Unchecked="SelectionCheck_Changed"/>

                <Button x:Name="FavoriteButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="34" Height="34" Margin="0,7,7,0" Padding="0" FontSize="20"
                        Foreground="#E8EBF2" Background="#B0101217" BorderThickness="0"
                        ToolTip="收藏" Click="FavoriteButton_Click" Panel.ZIndex="10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="17">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="PlaylistButton" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Width="32" Height="32" Margin="0,0,7,7" Padding="0" FontSize="22"
                        Foreground="White" Background="#D95865F2" BorderThickness="0"
                        ToolTip="加入播放列表" Click="PlaylistButton_Click" Panel.ZIndex="10">
                    <Button.Template><ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                    </ControlTemplate></Button.Template>
                    <TextBlock Text="＋"/>
                </Button>

                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7"
                        Padding="6,3" Background="#D9101217" CornerRadius="6" Panel.ZIndex="9">
                    <TextBlock x:Name="VideoDuration" Foreground="White" FontSize="12"/>
                </Border>

            </Grid>


            <StackPanel Grid.Row="1"
                        Margin="8">
                <TextBlock x:Name="VideoName"
                           Foreground="White"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>


            </StackPanel>


        </Grid>


    </Border>


</UserControl>
